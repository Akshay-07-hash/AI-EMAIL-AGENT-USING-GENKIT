# functions/.env.example
# ============================================================================
# Firebase Cloud Functions - Server-Only Environment Configuration
# ============================================================================
# IMPORTANT SECURITY NOTICE:
# These variables are strictly for backend / server-side execution.
# They are NEVER loaded into the React frontend, Vite bundle, or browser.
# ============================================================================

GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:5173

# Step 5: Gemini AI Key (Used exclusively by Genkit on the backend)
GEMINI_API_KEY=your_gemini_api_key_here
